---
import { Image } from 'astro:assets';
import { imageDimensions } from '../lib/images';

interface Props {
  src: string;
  alt: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  sizes?: string;
}

const { src, alt, class: className, loading = 'lazy', sizes } = Astro.props;
const dimensions = imageDimensions[src];

if (!dimensions) {
  throw new Error(`Missing image dimensions for ${src}`);
}
---

<Image
  src={src}
  alt={alt}
  width={dimensions.width}
  height={dimensions.height}
  loading={loading}
  decoding="async"
  sizes={sizes}
  class={className}
/>
