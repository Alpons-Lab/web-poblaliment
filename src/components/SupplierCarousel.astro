---
import { suppliers, supplierCategories } from '../data/suppliers';
import type { Locale } from '../lib/i18n';
import { localizedPath } from '../lib/i18n';
import SupplierMark from './SupplierMark.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const isSpanish = locale === 'es';
const directoryPath = localizedPath(locale, 'brands');
---

<div class="supplier-carousel" data-supplier-carousel>
  <div class="supplier-carousel-controls">
    <span>{suppliers.length} {isSpanish ? 'marcas y proveedores' : 'marques i proveïdors'}</span>
    <div>
      <button
        type="button"
        data-direction="previous"
        aria-label={isSpanish ? 'Marcas anteriores' : 'Marques anteriors'}
      >
        ←
      </button>
      <button
        type="button"
        data-direction="next"
        aria-label={isSpanish ? 'Marcas siguientes' : 'Marques següents'}
      >
        →
      </button>
    </div>
  </div>
  <section
    class="supplier-carousel-track"
    aria-label={isSpanish ? 'Carrusel de marcas' : 'Carrusel de marques'}
  >
    {suppliers.map((supplier) => {
      const categoryIndex = supplierCategories.indexOf(supplier.category);
      const category = isSpanish ? supplier.categoryEs : supplier.category;
      return (
        <a class="supplier-carousel-item" href={`${directoryPath}#categoria-${categoryIndex}`}>
          <SupplierMark supplier={supplier} />
          <span class="supplier-carousel-copy">
            <strong>{supplier.name}</strong>
            <span>
              {supplier.principal ? (isSpanish ? 'Marca principal' : 'Marca principal') : category}
            </span>
          </span>
          <span class="supplier-carousel-arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      );
    })}
  </section>
</div>

<script>
document.querySelectorAll<HTMLElement>('[data-supplier-carousel]').forEach((carousel) => {
  const track = carousel.querySelector<HTMLElement>('.supplier-carousel-track');
  if (!track) return;
  carousel.querySelectorAll<HTMLButtonElement>('button[data-direction]').forEach((button) => {
    button.addEventListener('click', () => {
      const direction = button.dataset.direction === 'next' ? 1 : -1;
      track.scrollBy({ left: direction * track.clientWidth * 0.78, behavior: 'smooth' });
    });
  });
});
</script>
